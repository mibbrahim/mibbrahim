# Name shown to patients
PRACTICE_NAME="Dr. Naser Ahmadi's Office"

# Comma-separated list of insurance plans the practice accepts.
# Replace with the real list for Naser Ahmadi. If unset, the default list in lib/config.ts is used.
ACCEPTED_PLANS="Aetna PPO,Anthem Blue Cross PPO,Blue Shield of California PPO,Cigna PPO,UnitedHealthcare PPO,Medicare Part B"

# PIN the phone agent types on /agent to see submissions. Required for /agent to work.
AGENT_PIN="change-me"

# Storage (required on Vercel so the agent can see what the patient submitted).
# Add an Upstash Redis / Vercel KV store from the Vercel Marketplace; it sets one of these pairs for you.
KV_REST_API_URL=""
KV_REST_API_TOKEN=""
# UPSTASH_REDIS_REST_URL=""
# UPSTASH_REDIS_REST_TOKEN=""

# How long submissions (including ID/insurance photos) are kept, in days.
RETENTION_DAYS="30"
