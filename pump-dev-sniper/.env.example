# Copy to .env and `set -a; source .env; set +a` before running live.
# Your low-latency RPC (HTTP + websocket). Public endpoints work for paper trading only.
RPC_URL=https://your-rpc.example.com/?api-key=...
WS_URL=wss://your-rpc.example.com/?api-key=...
# Comma-separated endpoints that accept sendTransaction (your RPC, a staked sender, Jito block engine, ...)
SEND_URLS=https://your-rpc.example.com/?api-key=...,https://mainnet.block-engine.jito.wtf/api/v1/transactions
# Optional: tip accounts required by your sender service (default: Jito tip accounts)
TIP_ACCOUNTS=
# Trading wallet: use a FRESH wallet holding only what you are willing to lose.
PRIVATE_KEY=
# or KEYPAIR_PATH=/path/to/keypair.json
