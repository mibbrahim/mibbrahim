# /etc/hsnipe/common.env — shared by all three strategies (chmod 600: holds your tokens)

# Yellowstone gRPC (Constant-K Kaldera). Two endpoints = both streams, first copy wins.
HS_GRPC_URLS=https://YOUR-FRANKFURT-KALDERA-ENDPOINT,https://YOUR-NEWYORK-KALDERA-ENDPOINT
HS_GRPC_X_TOKEN=YOUR_X_TOKEN
HS_STREAM_IDLE_TIMEOUT_S=10

# RPC for blockhash fallback, balance and backfill; staked RPC (SWQoS) for sending.
HS_RPC_URL=https://YOUR-CONSTANTK-RPC
HS_STAKED_RPC_URL=https://YOUR-CONSTANTK-STAKED-RPC
HS_JITO_URLS=https://frankfurt.mainnet.block-engine.jito.wtf/api/v1/transactions,https://ny.mainnet.block-engine.jito.wtf/api/v1/transactions

# Fallback SOL price until the first live quote arrives (Jupiter/Coinbase/Binance, every 30 s)
HS_SOL_PRICE_USD=150

# Paper books: landing 0, 1 and 2 slots after the signal
HS_PAPER_DELAYS=0,1,2
HS_PAPER_SIZE_SOL=0.1
HS_MAX_OPEN=10
# end = fill after every other trade in the landing slot (conservative); start = before them
HS_PAPER_FILL_AT=end
HS_PAPER_BUY_COST_SOL=0.0012
HS_PAPER_SELL_COST_SOL=0.0012
HS_PAPER_EMERG_SELL_COST_SOL=0.004

# Record every event of tracked coins (gzipped, hourly files) so backtests can replay it
HS_RECORD=1
HS_RECORD_ROTATE_MIN=60
HS_SUMMARY_EVERY_S=30
HS_NEAR_MISS=1
