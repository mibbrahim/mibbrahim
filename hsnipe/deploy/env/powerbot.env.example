# /etc/hsnipe/powerbot.env — Strategy 2 "PowerBot"
# All quality thresholds below are PLACEHOLDERS: tune them from near_misses.jsonl.

PWB_MIN_HOLDERS=50
# cross = judge when holders reaches PWB_MIN_HOLDERS; continuous = every trade after
PWB_TRIGGER=cross
PWB_MAX_AGE_S=1800
PWB_TOP10_MIN=0
PWB_TOP10_MAX=1
PWB_SMALL_BUY_SOL=0.02
# share of buys under PWB_SMALL_BUY_SOL (farmed launches)
PWB_MAX_SMALL_BUY_SHARE=0.50
# buys in the creation slot (bundled launches)
PWB_MAX_CREATION_SLOT_BUYS=5
# supply held by creation-slot buyers
PWB_MAX_SNIPER_PCT=0.15
PWB_REJECT_MAYHEM=1
# optional extra filters (0 = off)
PWB_MAX_DEV_PCT=0
PWB_MIN_VOLUME_USD=0
PWB_MAX_ENTRY_MCAP_SOL=0
PWB_BUNDLE=0

# exits: hard stop until +PWB_TRAIL_ARM_PCT is first reached, then trailing stop
PWB_HARD_STOP=-0.30
PWB_TRAIL_ARM_PCT=0.30
PWB_TRAIL_PCT=0.20
PWB_TIME_STOP_S=900
PWB_SELL_ON_GRAD=0
PWB_GRAD_DELAY_MS=0
