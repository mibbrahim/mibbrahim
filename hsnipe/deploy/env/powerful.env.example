# /etc/hsnipe/powerful.env — Strategy 1 "Powerful Bot" (defaults = the spec)

# ---- entry window
PB_MIN_AGE_S=60
PB_MAX_AGE_S=300
# FINAL
PB_MIN_M1_BUYERS=25
# (buy_sol + sell_sol) x SOL price
PB_MIN_VOLUME_USD=11000
PB_MAX_M1_SOLD_FRAC=0.40
# trades in 2nd half of life >= 0.5 x 1st half
PB_MIN_STALL_RATIO=0.5
# top 2 buyers' share of all buy SOL
PB_MAX_TOP2_SHARE=0.50
# FINAL: one wallet holds >= 90% of 793.1M tokens
PB_MAX_WALLET_CURVE_SHARE=0.90

# ---- trap 1: bundled launches (placeholders, tune from near_misses.jsonl)
PB_BUNDLE=1
PB_BUNDLE_WINDOW_S=60
# share of early buyers with an identical (CU limit, CU price)
PB_BUNDLE_FEE_SHARE=0.40
PB_BUNDLE_FEE_MIN_N=10
# adjacent same-slot buys from distinct wallets
PB_BUNDLE_GROUP_SIZE=4
PB_BUNDLE_MAX_GROUPS=3
# buyer left with < this after buying = fresh/funded wallet
PB_BUNDLE_DRAINED_SOL=0.01
PB_BUNDLE_DRAINED_SHARE=0.50

# ---- trap 3: entry market cap cap in SOL (0 = off; graduation is ~400 SOL)
PB_MAX_ENTRY_MCAP_SOL=0

# ---- exits (priority order)
PB_HARD_STOP=-0.40
PB_TP1_PCT=1.00
PB_TP1_FRAC=0.3333
PB_TP2_PCT=2.00
PB_TP2_FRAC=0.3333
PB_TRAIL_PCT=0.30
PB_TIME_STOP_S=900
# trap 4: wait after migration before selling on PumpSwap
PB_GRAD_DELAY_MS=0

# ---- trap 2: profit protection below 2x (0 = off)
# e.g. 0.5 = sell PB_PP_TP_FRAC at +50%
PB_PP_TP_PCT=0
PB_PP_TP_FRAC=0.3333
# 1 = the partial also arms the 30% trailing stop
PB_PP_ARMS_TRAIL=0
# e.g. 0.3 = once +30% was reached ...
PB_BE_ARM_PCT=0
# ... exit if P&L falls back to this
PB_BE_STOP_PCT=0

# ---- live trading (Powerful Bot only). Start with HS_LIVE_SIMULATE=1.
HS_LIVE=0
# build + sign + simulateTransaction; no funds move
HS_LIVE_SIMULATE=1
HS_KEYPAIR=/etc/hsnipe/wallet.json
HS_LIVE_SIZE_SOL=0.05
HS_LIVE_MAX_OPEN=3
HS_LIVE_MIN_BALANCE_SOL=0.3
HS_LIVE_BUY_SLIPPAGE_BPS=1500
HS_LIVE_SELL_SLIPPAGE_BPS=2000
HS_LIVE_CU_LIMIT=160000
# micro-lamports per CU
HS_LIVE_CU_PRICE=400000
# lamports
HS_LIVE_JITO_TIP=200000
HS_LIVE_EMERG_CU_PRICE=3000000
HS_LIVE_EMERG_JITO_TIP=1000000
# refuse to send with an older cached blockhash
HS_LIVE_MAX_BLOCKHASH_AGE=100
HS_LIVE_CONFIRM_TIMEOUT_SLOTS=40
HS_LIVE_MAX_SELL_RETRIES=8
# reclaim ~0.002 SOL token-account rent after a full exit
HS_LIVE_CLOSE_ATA=1
# exists -> no new entries
HS_STOP_FILE=STOP
# exists -> emergency-sell everything, no new entries
HS_KILL_FILE=KILL
HS_POSITIONS_FILE=positions.json
