# /etc/hsnipe/gymer.env — Strategy 3 "Gymer Bot" (stricter placeholders)
# All quality thresholds below are PLACEHOLDERS: tune them from near_misses.jsonl.

GYM_MIN_HOLDERS=50
# cross = judge when holders reaches GYM_MIN_HOLDERS; continuous = every trade after
GYM_TRIGGER=cross
GYM_MAX_AGE_S=1800
GYM_TOP10_MIN=0.25
GYM_TOP10_MAX=0.30
GYM_SMALL_BUY_SOL=0.02
# share of buys under GYM_SMALL_BUY_SOL (farmed launches)
GYM_MAX_SMALL_BUY_SHARE=0.30
# buys in the creation slot (bundled launches)
GYM_MAX_CREATION_SLOT_BUYS=3
# supply held by creation-slot buyers
GYM_MAX_SNIPER_PCT=0.10
GYM_REJECT_MAYHEM=1
# optional extra filters (0 = off)
GYM_MAX_DEV_PCT=0
GYM_MIN_VOLUME_USD=0
GYM_MAX_ENTRY_MCAP_SOL=0
GYM_BUNDLE=0

# exits: hard stop until +GYM_TRAIL_ARM_PCT is first reached, then trailing stop
GYM_HARD_STOP=-0.30
GYM_TRAIL_ARM_PCT=0.30
GYM_TRAIL_PCT=0.20
GYM_TIME_STOP_S=900
GYM_SELL_ON_GRAD=0
GYM_GRAD_DELAY_MS=0
